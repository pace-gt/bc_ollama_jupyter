# Batch Connect app configuration file
#
# @note Used to define the submitted cluster, title, description, and
#   hard-coded/user-defined attributes that make up this Batch Connect app.
---

# **MUST** set cluster id here that matches cluster configuration file located
# under /etc/ood/config/clusters.d/*.yml
# @example Use the Owens cluster at Ohio Supercomputer Center
#     cluster: "owens"
cluster: ""

# Define attribute values that aren't meant to be modified by the user within
# the Dashboard form
attributes:
  # Set the corresponding modules that need to be loaded for Jupyter to run
  #
  # @note It is called within the batch job as `module load <modules>` if
  #   defined
  # @example Do not load any modules
  #     modules: ""
  # @example Using default python module
  #     modules: "python"
  # @example Using specific python module
  #     modules: "python/3.5"
  # @example Using combination of modules
  #     modules: "python/3.5 cuda/8.0.44"
  modules: "python"

  # Any extra command line arguments to feed to the `jupyter notebook ...`
  # command that launches the Jupyter notebook within the batch job
  extra_jupyter_args: ""

# All of the attributes that make up the Dashboard form (in respective order),
# and made available to the submit configuration file and the template ERB
# files
#
# @note You typically do not need to modify this unless you want to add a new
#   configurable value
# @note If an attribute listed below is hard-coded above in the `attributes`
#   option, then it will not appear in the form page that the user sees in the
#   Dashboard
cluster: "hive-slurm"
attributes:
  modules:
    widget: select
    label: "Anaconda Module"
    options:
      - [ "Anaconda 3 - 2021.05", "anaconda3/2021.05" ]
      - [ "Anaconda 3 - 2022.05", "anaconda3/2022.05" ]
      - [ "Anaconda 3 - PyTorch 1.12", "pytorch/1.12.0" ]
      - [ "Anaconda 3 - TensorFlow GPU 2.6.0", "tensorflow-gpu/2.9.1" ]
  extra_jupyter_args: ""
  bc_account:
    label: "Tracking Account"
    help: "Required.  Has the format: `p-<PI username>`"
  custom_queue:
    id: bc_queue
    widget: select
    label: "Partition"
    cacheable: false
    options:
      - [ "hive","hive" ]
      - [ "hive-gpu","hive-gpu" ]
      - [ "hive-dev","hive-dev" ]
  bc_num_slots:
    label: "Nodes"
    min: 1
    max: 2
    step: 1
    value: 1
    help: "Max limit currently 2 for dev partitions.  TODO: Set max limit for prod partitions."
  num_cores:
    id: num_cores
    widget: number_field
    label: "Cores Per Node"
    min: 1
    step: 1
    value: 1
    # Max will get properly initialized in form.js
    help: 'Number of cores (CPUs) per node.  Max: 24 cores per node.'
  num_mem_per_core:
    id: num_mem_per_core
    widget: number_field
    label: "Memory Per Core (GB)"
    min: 1
    step: 1
    max: 32
    value: ""
    help: "Leave blank if unsure.\nTotal memory for job is: nodes × cores × memory per core.  Max: 32GB per core."
  num_gpus:
    id: num_gpus
    label: "GPUs Per Node"
    widget: number_field
    step: 1
    # Min, max, and value will get initialized properly in form.js
  bc_num_hours:
    help: "TODO: Set max vals for prod partitions."

form:
  - modules
  - extra_jupyter_args
  - bc_account
  - custom_queue
  - bc_num_slots
  - num_cores
  - num_gpus
  - num_mem_per_core
  - bc_num_hours
  - bc_email_on_started
