title: Ollama + Jupyter
cluster: "phoenix-dev"
attributes:
  jupyter_interface:
    widget: select
    label: "Jupyter Interface"
    options:
      - ["Jupyter Notebook", "notebook"]
      - ["JupyterLab", "lab"]
    value: "Jupyter Notebook"
  model_dir_select:
    widget: select
    label: "Models Directory"
    options:
      - ["PACE shared models", "shared", data-hide-model-dir: true, data-set-model-dir: "/storage/coda1/d-pace_community/0/ollama/models"]
      - ["Temporary directory", "tmpdir", data-hide-model-dir: true, data-set-model-dir: "$TMPDIR/models"]
      - ["Custom directory...", "custom",  data-set-model-dir: ""]
    help: |
      Location for Ollama models that are downloaded or imported.

      * *PACE shared models* : Contains already-downloaded models.  Maintained and updated by PACE staff.  
        It is read-only and does not allow you to download/import additional models.
      * *Tempoary directory* : Temporary storage that does *not* persist after the OOD session ends.  
        This is writable and allows you to download/import additional models.
      * *Custom directory...* : A directory chosen by you.  If the location is writeable, you can download/import additional models.  
        It is recommended to use a directory in `~/project`,  `~/shared`, or `~/scratch` space.  
  model_dir:
    widget: "path_selector"
    label: "Custom Models Directory"
    directory: "<%= CurrentUser.home %>"
    required: true
    show_files: false
    readonly: false
    show_hidden: true
  node_type:
    id: node_type
    label: "Node Type"
    widget: select
    options:
      - ['NVIDIA GPU V100 16GB', 'V100_16GB']
      - ['NVIDIA GPU RTX6000', 'RTX_6000']
  num_gpus:
    id: num_gpus
    label: "GPUs"
    widget: number_field
    # Min, max, and val will get initialized properly in form.js
    step: 1
    value: 1
  num_cores:
    id: num_cores
    widget: number_field
    label: "CPUs"
    # Max and val will get properly initialized in form.js
    min: 1
    step: 1
    value: 4
  num_mem:
    id: num_mem
    widget: number_field
    label: "Memory (GB)"
    min: 1
    step: 1
    value: 32
  bc_account:
    label: "Charge Account"
    required: true
  qos:
    widget: select
    label: "Quality of Service"
    options:
      - ["embers"]
      - ["inferno"]
    value: "inferno"

form:
  - jupyter_interface
  - model_dir_select
  - model_dir
  - node_type
  - num_gpus
  - num_cores
  - num_mem
  - bc_num_hours
  - bc_account
  - qos
  - bc_email_on_started
