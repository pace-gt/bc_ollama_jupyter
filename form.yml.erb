title: "Jupyter"
cluster: "phoenix"
attributes:
  #modules: "anaconda3/2020.11"
  modules:
    widget: select
    label: "Anaconda Module"
    help: "This defines the version of Anaconda3 you want to load."
    options:
      - [ "Anaconda 3 - 2020.11", "anaconda3/2020.11" ]
      - [ "Anaconda 3 - 2021.05", "anaconda3/2021.05" ]
      - [ "Anaconda 3 - PyTorch 1.11.0", "pytorch/1.11.0" ]
      - [ "Anaconda 3 - TensorFlow GPU 2.6.0", "tensorflow-gpu/2.6.0" ]
  extra_jupyter_args: ""
  custom_shell_text:
    widget: text_area
    help: |
      WARNING: use with care as this field gets inserted into your job script. 
      Example text:
      conda activate base
  desktop: "gnome"
  bc_vnc_idle: 0
  bc_vnc_resolution:
    required: true
  node_type:
    widget: select
    label: "Node Type"
    cacheable: false
    options:
      - [ "CPU Only", "cpu"]
      - [ "CPU with Local SAS", "cpusas"]
      - [ "GPU RTX6000", "RTX6000"]
      - [ "GPU TeslaV100-16GB", "TeslaV100-16GB"]
      - [ "GPU TeslaV100-32GB", "TeslaV100-32GB"]
  num_gpus:
    id: num_gpus
    label: GPUs Per Node
    help: "Number of CUDA enabled GPUs per node.  Maximum 4 NVIDIA RTX6000 GPUs per node or 2 NVIDIA V100 GPUs per node."
    max: 4
    min: 0
    step: 1
    value: 0
    widget: number_field
    cacheable: false
  custom_queue:
    widget: select
    id: bc_queue
    label: "Queue"
    cacheable: false
    options:
      - [ "Inferno - main and default queue (charges credits)", "inferno"]
      - [ "Embers - low priority, preemptible backfill queue (8 hour limit)", "embers"]
  custom_template:
    widget: select
    label: "Starting Template"
    cacheable: false
    options:
      - [ "None - use Jupyter to select file to work on", ""]
      - [ "Python3 - template to show how to work custom environments", "Python3.ipynb"]
      - [ "Julia - template to show how to work with user Julia envionments", "Julia.ipynb"]
  num_cores:
    help: 'Number of cores (CPUs).  Maximum: 24 per node.'
    id: num_cores
    label: Cores Per Node
    max: 24
    min: 1
    step: 1
    value: 1
    widget: number_field
    cacheable: false
  num_mem_per_core:
    help: "Leave the field blank if unsure.\nTotal memory for job is: nodes × cores × memory per core.  Maximum: 32GB per core."
    id: num_mem_per_core
    label: Memory per Core (GB)
    value: ""
    min: 1
    step: 1
    max: 32
    widget: number_field
    cacheable: false
  email:
    help: 'Leave the field blank if you don''t want to be notified.'
    id: email
    label: Email
    widget: text_field
    cacheable: false
  bc_num_hours:
    id: bc_num_hours
    value: 1
    min: 1
    label: 'Number of Hours'
    help: "Maximum: 504h for inferno CPU-only, 72h for inferno GPU, 8h for embers CPU or GPU"
  bc_account:
    label: Charge Account (Required)
  custom_template: ""

form:
  - modules
  - extra_jupyter_args
  - desktop
  - bc_account
  - custom_queue
  - node_type
  - num_cores
  - num_gpus
  - num_mem_per_core
  - bc_num_hours
  - email
