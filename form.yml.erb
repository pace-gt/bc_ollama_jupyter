title: Ollama + Jupyter (Beta)
cluster: "phoenix-rh9"
attributes:
  python_env:
    widget: select
    label: "Python environment"
    options:
      - [ "Default", "default", data-hide-venv-path: true, data-hide-sif-path: true ]
      - [ "Custom virtual environment...", "venv", data-hide-sif-path: true ]
      - [ "Custom Apptainer image...", "apptainer", data-hide-venv-path: true ]
    value: "Default"
    cacheable: true
    help: |
      * *Default*: Preinstalled environment with the `ollama`, `openai`, and `requests` Python packages.
      * *Custom virtual environment..* : The top-level directory of an existing Python virtual environment, created via `venv`.  The env must have the `jupyter` package installed.
      * *Custom Apptainer image...* : Path to an existing Apptainer image file.  The image must have Python and `jupyter` installed and available on the container's `$PATH`.
  venv_path:
    widget: "path_selector"
    label: "Virtual environment path"
    directory: "<%= CurrentUser.home %>"
    readonly: false
    show_hidden: false
    show_files: false
    cacheable: true
    favorites:
      - "<%= CurrentUser.home %>"
  sif_path:
    widget: "path_selector"
    label: "Apptainer image path"
    directory: "<%= CurrentUser.home %>"
    readonly: false
    show_hidden: false
    cacheable: true
    favorites:
      - "<%= CurrentUser.home %>"
  jupyter_interface:
    widget: select
    label: "Jupyter interface"
    options:
      - ["Jupyter Notebook", "notebook"]
      - ["JupyterLab", "lab"]
    value: "JupyterLab"
    cacheable: true
  model_dir_select:
    widget: select
    label: "Ollama models directory"
    options:
      - ["PACE shared models", "pace", data-hide-model-dir: true]
      - ["Temporary directory", "tmpdir", data-hide-model-dir: true]
      - ["Custom directory...", "custom"]
    help: |
      * *PACE shared models* : Contains already-downloaded models.  It is read-only and does not allow you to download/import additional models.
      * *Tempoary directory* : Does *not* persist after the OOD session ends.  This is writable and allows you to download/import additional models.
      * *Custom directory...* : An existing directory chosen by you.  If the location is writeable, you can download/import additional models.  This allows you to re-use models between OOD sessions.  It is recommended to use a directory in `~/project`,  `~/shared`, or `~/scratch`.
    value: "PACE shared models"
    cacheable: true
  model_dir:
    widget: "path_selector"
    label: "Custom models directory"
    directory: "<%= CurrentUser.home %>"
    show_files: false
    readonly: false
    show_hidden: true
    cacheable: true
    favorites:
      - "<%= CurrentUser.home %>"
  bc_account:
    label: "Charge Account"
    help: "Required.  Has the format: `gts-<PI username>`"
    required: true
  qos:
    widget: select
    label: "Quality of Service"
    options:
      - ["embers"]
      - ["inferno"]
    value: "inferno"
    help: |
      Determines the priority of this job and whether your job incurs account charges. See our [QOS guide](https://gatech.service-now.com/home?id=kb_article_view&sysparm_article=KB0041998#qos-on-the-phoenix-slurm-cluster) for full info. 
      
      * inferno: Jobs have normal priority are charged to your account.  
      * embers:  Jobs are not charged to your account but have lower priority.   
  node_type:
    id: node_type
    label: "Node Type"
    widget: select
    options:
      - ['CPU-only, Intel', 'intel_cpu',
          data-hide-num-gpus: true,
          data-max-num-gpus: 0,
          data-min-num-gpus: 0,
          data-max-bc-num-slots: 663,
          data-max-num-cores: 32,
          data-max-num-mem-per-core: 772,
          data-max-bc-num-hours: 504
        ]
      - ['CPU-only, AMD', 'amd_cpu',
          data-hide-num-gpus: true,
          data-max-num-gpus: 0,
          data-min-num-gpus: 0,
          data-max-bc-num-slots: 12,
          data-max-num-cores: 128,
          data-max-num-mem-per-core: 3095,
          data-max-bc-num-hours: 504
        ]
      - ['NVIDIA GPU A100 40GB', 'A100_40GB',
          data-max-num-gpus: 2,
          data-min-num-gpus: 1,
          data-max-bc-num-slots: 6,
          data-max-num-cores: 64,
          data-max-num-mem-per-core: 515,
          data-max-bc-num-hours: 504
        ]
      - ['NVIDIA GPU A100 80GB', 'A100_80GB',
          data-max-num-gpus: 8,
          data-min-num-gpus: 1,
          data-max-bc-num-slots: 7,
          data-max-num-cores: 64,
          data-max-num-mem-per-core: 2051,
          data-max-bc-num-hours: 504
        ]
      - ["NVIDIA GPU H100 HGX (64-core CPU)", "H100_HGX",
          data-max-num-gpus: 8,
          data-min-num-gpus: 1,
          data-max-bc-num-slots: 3,
          data-max-num-cores: 64,
          data-max-num-mem-per-core: 2063,
          data-max-bc-num-hours: 72
        ]
      - ["NVIDIA GPU H100 DGX (112-core CPU)", "H100_DGX",
          data-max-num-gpus: 8,
          data-min-num-gpus: 1,
          data-max-bc-num-slots: 1,
          data-max-num-cores: 112,
          data-max-num-mem-per-core: 2063,
          data-max-bc-num-hours: 72
        ]
      - ['NVIDIA GPU RTX6000', 'RTX_6000',
          data-max-num-gpus: 4,
          data-min-num-gpus: 1,
          data-max-bc-num-slots: 18,
          data-max-num-cores: 24,
          data-max-num-mem-per-core: 772,
          data-max-bc-num-hours: 504
        ]
      - ['NVIDIA GPU V100 16GB', 'V100_16GB',
          data-max-num-gpus: 2,
          data-min-num-gpus: 1,
          data-max-bc-num-slots: 10,
          data-max-num-cores: 24,
          data-max-num-mem-per-core: 772,
          data-max-bc-num-hours: 504
        ]
      - ['NVIDIA GPU V100 32GB', 'V100_32GB',
          data-max-num-gpus: 2,
          data-min-num-gpus: 1,
          data-max-bc-num-slots: 4,
          data-max-num-cores: 24,
          data-max-num-mem-per-core: 772,
          data-max-bc-num-hours: 504
        ]
      - ['NVIDIA GPU L40S', 'L40S',
          data-max-num-gpus: 8,
          data-min-num-gpus: 1,
          data-max-bc-num-slots: 8,
          data-max-num-cores: 32,
          data-max-num-mem-per-core: 515,
          data-max-bc-num-hours: 72
        ]
    help: |
      Hardware specs for all node types are listed [here](https://gatech.service-now.com/technology?id=kb_article_view&sysparm_article=KB0041976).
  num_cores:
    widget: number_field
    label: "Number of CPUs (cores)"
    min: 1
    step: 1
  num_mem:
    widget: number_field
    label: "Total memory (GB)"
    min: 1
    step: 1
    value: 32
  num_gpus:
    label: "Number of GPUs"
    widget: number_field
    step: 1

form:
  - python_env
  - sif_path
  - venv_path
  - model_dir_select
  - model_dir
  - jupyter_interface
  - node_type
  - num_gpus
  - num_cores
  - num_mem
  - bc_num_hours
  - bc_account
  - qos
  - bc_email_on_started
