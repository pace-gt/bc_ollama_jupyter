title: Jupyter
cluster: "ice-rh9"
attributes:
  version:
    id: version
    widget: select
    label: "Anaconda Module"
    options:
      - [ "Anaconda3 2023.03", "anaconda3/2023.03" ]
      - [ "TensorFlow 2.13", "tensorflow/2.13" ]
      - [ "PyTorch 2.1.0", "pytorch/2.1.0" ]
      - [ "Pillow 10.2.0 + scikit-learn 1.4.0 + PyTorch 2.1.0", "pillow/10.2.0"]
  jupyter_interface:
    widget: select
    label: "Jupyter Interface"
    options:
      - ["Jupyter Notebook", "notebook"]
      - ["JupyterLab", "lab"]
    value: "Jupyter Notebook"
  extra_jupyter_args: ""
  qos:
    widget: select
    label: "Quality of Service"
    options:
      - ["Default (none)", ""]
      - ["coc-ice", "coc-ice"]
      - ["coc-grade", "coc-grade"]
      - ["coe-ice", "coe-ice"]
      - ["coe-grade", "coe-grade"]
      - ["pace-ice", "pace-ice"]
      - ["pace-grade", "pace-grade"]
    value: "Default (none)"
  node_type:
    id: node_type
    label: "Node Type"
    widget: select
    options:
      - ['CPU (first avail)', 'cpu']
      - ['Intel CPU', 'intel_cpu']
      - ['Intel CPU localSAS', 'intel_cpu_sas']
      - ['AMD CPU', 'amd_cpu']
      - ['NVIDIA GPU (first avail)', 'nvidia_gpu']
      - ['NVIDIA GPU V100 16GB', 'V100_16GB']
      - ['NVIDIA GPU V100 32GB', 'V100_32GB']
      - ['NVIDIA GPU A100 40GB', 'A100_40GB']
      - ['NVIDIA GPU A100 80GB', 'A100_80GB']
      - ['NVIDIA GPU RTX6000', 'RTX_6000']
      - ['NVIDIA GPU A40', 'A40']
      - ["NVIDIA GPU H100 HGX", "H100_HGX"]
      - ['AMD GPU M1210', 'MI210']
  bc_num_slots:
    label: "Nodes"
    # Max and val will get properly initialized in form.js
    min: 1
    step: 1
  num_cores:
    id: num_cores
    widget: number_field
    label: "Cores Per Node"
    # Max and val will get properly initialized in form.js
    min: 1
    step: 1
    help: 'Number of cores (CPUs) per node'
  num_mem_per_core:
    id: num_mem_per_core
    widget: number_field
    label: "Memory Per Core (GB)"
    min: 1
    step: 1
    value: ""
    help: "Leave blank if unsure."
  num_gpus:
    id: num_gpus
    label: "GPUs Per Node"
    widget: number_field
    # Min, max, and val will get initialized properly in form.js
    step: 1

form:
  - version
  - extra_jupyter_args
  - jupyter_interface
  - qos
  - node_type
  - bc_num_slots
  - num_cores
  - num_gpus
  - num_mem_per_core
  - bc_num_hours
  - bc_email_on_started
