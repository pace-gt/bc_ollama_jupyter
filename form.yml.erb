title: Ollama + Jupyter
cluster: "ice-rh9"
attributes:
  python_env:
    widget: select
    label: "Python environment"
    options:
      - [ "Default", "default", data-hide-venv-path: true, data-hide-sif-path: true ]
      - [ "Custom virtual environment...", "venv", data-hide-sif-path: true ]
      - [ "Custom Apptainer image...", "apptainer", data-hide-venv-path: true ]
    value: "Default"
    cacheable: true
    help: |
      * *Default*: Preinstalled environment with the `ollama` and `openai` packages.
      * *Custom virtual environment..* : The top-level directory of an existing Python virtual environment, created via `venv`.  The env must have the `jupyter` package installed.
      * *Custom Apptainer image...* : Path to an existing Apptainer image file.  The image must have Python and `jupyter` installed and available on the container's `$PATH`.
  venv_path:
    widget: "path_selector"
    label: "Virtual environment path"
    directory: "<%= CurrentUser.home %>"
    readonly: false
    show_hidden: false
    show_files: false
    cacheable: true
    favorites:
      - "<%= CurrentUser.home %>"
  sif_path:
    widget: "path_selector"
    label: "Apptainer image path"
    directory: "<%= CurrentUser.home %>"
    readonly: false
    show_hidden: false
    cacheable: true
    favorites:
      - "<%= CurrentUser.home %>"
  jupyter_interface:
    widget: select
    label: "Jupyter interface"
    options:
      - ["Jupyter Notebook", "notebook"]
      - ["JupyterLab", "lab"]
    value: "JupyterLab"
    cacheable: true
  model_dir_select:
    widget: select
    label: "Ollama models directory"
    options:
      - ["PACE shared models", "pace", data-hide-model-dir: true]
      - ["Temporary directory", "tmpdir", data-hide-model-dir: true]
      - ["Custom directory...", "custom"]
    help: |
      * *PACE shared models* : Contains already-downloaded models.  It is read-only and does not allow you to download/import additional models.
      * *Tempoary directory* : Does *not* persist after the OOD session ends.  This is writable and allows you to download/import additional models.
      * *Custom directory...* : An existing directory chosen by you.  If the location is writeable, you can download/import additional models.  This allows you to re-use models between OOD sessions.  It is recommended to use a directory in `~/project`,  `~/shared`, or `~/scratch`.
    value: "PACE shared models"
    cacheable: true
  model_dir:
    widget: "path_selector"
    label: "Custom models directory"
    directory: "<%= CurrentUser.home %>"
    show_files: false
    readonly: false
    show_hidden: true
    cacheable: true
    favorites:
      - "<%= CurrentUser.home %>"
  node_type:
    id: node_type
    label: "Node type"
    widget: select
    options:
      - ['CPU (first avail)', 'cpu',
          data-hide-num-gpus: true,
          data-max-num-gpus: 0,
          data-min-num-gpus: 0,
          data-max-bc-num-slots: 64,
