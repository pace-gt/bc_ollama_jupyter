title: Ollama + Jupyter
cluster: "phoenix-dev"
attributes:
  jupyter_interface:
    widget: select
    label: "Jupyter Interface"
    options:
      - ["Jupyter Notebook", "notebook"]
      - ["JupyterLab", "lab"]
    value: "Jupyter Notebook"
  bc_account:
    label: "Charge Account"
    required: true
  qos:
    widget: select
    label: "Quality of Service"
    options:
      - ["embers"]
      - ["inferno"]
    value: "inferno"
  node_type:
    id: node_type
    label: "Node Type"
    widget: select
    options:
      - ['NVIDIA GPU V100 16GB', 'V100_16GB']
      - ['NVIDIA GPU RTX6000', 'RTX_6000']
  num_gpus:
    id: num_gpus
    label: "GPUs"
    widget: number_field
    # Min, max, and val will get initialized properly in form.js
    step: 1
    value: 1
  num_cores:
    id: num_cores
    widget: number_field
    label: "CPUs"
    # Max and val will get properly initialized in form.js
    min: 1
    step: 1
    value: 4
  num_mem:
    id: num_mem
    widget: number_field
    label: "Memory (GB)"
    min: 1
    step: 1
    value: 32

form:
  - bc_account
  - qos
  - jupyter_interface
  - node_type
  - num_gpus
  - num_cores
  - num_mem
  - bc_num_hours
  - bc_email_on_started
