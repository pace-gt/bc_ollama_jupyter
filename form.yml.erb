title: Jupyter
cluster: "phoenix-dev"
attributes:
  version:
    id: version
    widget: select
    label: "Anaconda Module"
    options:
      - [ "Anaconda3 2023.03", "anaconda3/2023.03" ]
      - [ "TensorFlow 2.13", "tensorflow/2.13" ]
      - [ "PyTorch 2.1.0", "pytorch/2.1.0" ]
      - [ "Pillow 10.2.0 + scikit-learn 1.4.0 + PyTorch 2.1.0", "pillow/10.2.0"]
  jupyter_interface:
    widget: select
    label: "Jupyter Interface"
    options:
      - ["Jupyter Notebook", "notebook"]
      - ["JupyterLab", "lab"]
    value: "Jupyter Notebook"
  extra_jupyter_args: ""
  bc_account:
    label: "Charge Account"
    required: true
  qos:
    widget: select
    label: "Quality of Service"
    options:
      - ["embers"]
      - ["inferno"]
    value: "inferno"
  node_type:
    id: node_type
    label: "Node Type"
    widget: select
    options:
      - ['CPU', 'cpu']
      - ['NVIDIA GPU V100 16GB', 'V100_16GB']
      - ['NVIDIA GPU RTX6000', 'RTX_6000']
  bc_num_slots:
    label: "Nodes"
    # Max and val will get properly initialized in form.js
    min: 1
    step: 1
  num_cores:
    id: num_cores
    widget: number_field
    label: "Cores Per Node"
    # Max and val will get properly initialized in form.js
    min: 1
    step: 1
    help: 'Number of cores (CPUs) per node'
  num_mem_per_core:
    id: num_mem_per_core
    widget: number_field
    label: "Memory Per Core (GB)"
    min: 1
    step: 1
    value: ""
    help: "Leave blank if unsure."
  num_gpus:
    id: num_gpus
    label: "GPUs Per Node"
    widget: number_field
    # Min, max, and val will get initialized properly in form.js
    step: 1

form:
  - version
  - extra_jupyter_args
  - jupyter_interface
  - bc_account
  - qos
  - node_type
  - bc_num_slots
  - num_cores
  - num_gpus
  - num_mem_per_core
  - bc_num_hours
  - bc_email_on_started
