#!/usr/bin/env bash
set -e -o pipefail

#logger -p user.notice -t "ondemand" -- "User: $USER; SubmitHost: $HOSTNAME; JobName: $SLURM_JOB_NAME; Queue: $SLURM_JOB_PARTITION; JobID: $SLURM_JOB_ID"

# Benchmark info
echo "TIMING - Starting main script at: $(date)"

# Set working directory to home directory
cd "${HOME}"

export PYTHONNOUSERSITE=1
module purge
module load ollama ollama-python
module list

# Start ollama server
apptainer instance run --nv "$OLLAMA_SIF" "ollama-server-$SLURM_JOB_ID"
apptainer instance list --logs

# Caputer logs from instance
function capture_in_instance_logs {
  # Argument is expected to be a regex with a capture group (parens)
  # for the file to find in `apptainer instance list --logs`
  regex=$1
  info="$(apptainer instance list --logs)"
  if [[ $info =~ $regex ]]; then
    src="${BASH_REMATCH[1]}"
    if [[ -f $src ]]; then
      dest="<%= session.staged_root %>/$(basename "$src")"
      echo "Tailing '$src' to '$dest'"
      tail -n +1 -F $src > $dest &
      return
    fi
  fi
  echo "WARNING: Could not find apptainer instance logfile matching '$regex'"
}

capture_in_instance_logs '(\S+err\b)'
capture_in_instance_logs '(\S+out\b)'

# Launch the Jupyter Notebook Server
set -x
jupyter <%= context.jupyter_interface %> --debug --config="$CONFIG_FILE" 
