#!/usr/bin/env bash

# Benchmark info
echo "TIMING - Starting main script at: $(date)"

# Set working directory to home directory
cd "${HOME}"

#
# Start Jupyter Notebook Server
#

<%- unless context.version.blank? -%>
# Purge the module environment to avoid conflicts
module purge
export PYTHONPATH=""

# Load the require modules
module load <%= context.version %>

# List loaded modules
module list
<%- end -%>

# Benchmark info
echo "TIMING - Starting jupyter at: $(date)"

# Launch the Jupyter Notebook Server
set -x
logger -p user.notice -t "ondemand" -- "User: $USER; SubmitHost: $HOSTNAME; JobName: $SLURM_JOB_NAME; Queue: $SLURM_JOB_PARTITION; JobID: $SLURM_JOB_ID"
<%- if context.version == "anaconda3/2023.03" %>
jupyter <%= context.jupyter_interface %> --debug --config="${CONFIG_FILE}" <%= context.extra_jupyter_args %> 
<%- elsif context.version == "tensorflow/2.13" %>
apptainer exec --nv "$TENSORFLOW_2_13_SIF" jupyter <%= context.jupyter_interface %> --debug --config="${CONFIG_FILE}" <%= context.extra_jupyter_args %>
<%- elsif context.version == "pytorch/2.1.0" %>
apptainer exec --nv "$PYTORCH_2_1_0_SIF" jupyter <%= context.jupyter_interface %> --debug --config="${CONFIG_FILE}" <%= context.extra_jupyter_args %>
<%- elsif context.version == "pillow/10.2.0" %>
apptainer exec --nv "$PILLOW_10_2_0_SIF" jupyter <%= context.jupyter_interface %> --debug --config="${CONFIG_FILE}" <%= context.extra_jupyter_args %>
<%- end -%>
