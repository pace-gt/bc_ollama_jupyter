#!/usr/bin/env bash
set -e -o pipefail

#logger -p user.notice -t "ondemand" -- "User: $USER; SubmitHost: $HOSTNAME; JobName: $SLURM_JOB_NAME; Queue: $SLURM_JOB_PARTITION; JobID: $SLURM_JOB_ID"

# =======================================
# Find a port for Ollama
# =======================================

# This finds an open port for Ollama.
# We don't want to directly use OOD's internal find_port 
# because it seems like OOD will use the discovered port to 
# proxy Jupyter (which we don't want!).  Here, I've copy-pasted
# OOD's shell functions with some changes.
my_find_port () {
    local host=localhost
    # The usual private port range for TCP
    local min_port=49152
    local max_port=65535
    local port_range=($(shuf -i ${min_port}-${max_port}))
    local retries=1 # number of retries over the port range if first attempt fails
    for ((attempt=0; attempt<=$retries; attempt++)); do
    for port in "${port_range[@]}"; do
        if my_port_used "${host}:${port}"; then
        continue
        fi
        echo "${port}"
        return 0 # success
    done
    done
    echo "error: failed to find available port in range ${min_port}..${max_port}" >&2
    return 1 # failure
}

my_port_used () {
    local port="${1#*:}"
    local host=$((expr "${1}" : '\\(.*\\):' || echo "localhost") | awk 'END{print $NF}')
    my_port_used_nc $host $port
    status=$?
    if [[ "$status" == "0" ]] || [[ "$status" == "1" ]]; then
        return $status
    fi
    return 127
}

my_port_used_nc(){
    nc -w 2 "$1" "$2" < /dev/null > /dev/null 2>&1
}

my_wait_until_port_used () {
    local port="${1}"
    local time="${2:-30}"
    for ((i=1; i<=time*2; i++)); do
    my_port_used "${port}"
    port_status=$?
    if [ "$port_status" == "0" ]; then
        return 0
    elif [ "$port_status" == "127" ]; then
        echo "commands to find port were either not found or inaccessible."
        echo "command options are lsof, nc, bash's /dev/tcp, or python (or python3) with socket lib."
        return 127
    fi
    sleep 0.5
    done
    return 1
}

# =======================================
# Startup Ollama
# =======================================

export ollama_port="$(my_find_port)"
export OLLAMA_HOST="127.0.0.1:$ollama_port"
export PYTHONNOUSERSITE=1

module purge
module load ollama

<%- if context.python_env == "default" %>
module load llm-python-apis
<%- elsif context.python_env == "venv" %>
source "<%= context.venv_path %>/bin/activate"
<%- end -%>

module list

<%- if context.model_dir_select == "pace" %>
export OLLAMA_MODELS="/storage/coda1/d-pace_community/0/ollama/models"
<%- elsif context.model_dir_select == "tmpdir" %>
export OLLAMA_MODELS="$TMPDIR/models"
mkdir -p "$OLLAMA_MODELS"
<%- elsif context.model_dir_select == "custom" %>
export OLLAMA_MODELS="<%= context.model_dir %>"
if [[ ! -d $OLLAMA_MODELS ]]; then
  echo "Error: Specified model directory '$OLLAMA_MODELS' does not exist"
  exit 1
fi
<%- end -%>

echo "Using model dir: $OLLAMA_MODELS"

apptainer instance run \
    --nv \
    --env "OLLAMA_HOST=$OLLAMA_HOST" \
    --env "OLLAMA_MODELS=$OLLAMA_MODELS" \
    "$OLLAMA_SIF" \
    "ollama-server-$SLURM_JOB_ID"
apptainer instance list --logs

# Caputer logs from instance
function capture_in_instance_logs {
  # Argument is expected to be a regex with a capture group (parens)
  # for the file to find in `apptainer instance list --logs`
  regex=$1
  info="$(apptainer instance list --logs)"
  if [[ $info =~ $regex ]]; then
    src="${BASH_REMATCH[1]}"
    if [[ -f $src ]]; then
      dest="<%= session.staged_root %>/$(basename "$src")"
      echo "Tailing '$src' to '$dest'"
      tail -n +1 -F $src > $dest &
      return
    fi
  fi
  echo "WARNING: Could not find apptainer instance logfile matching '$regex'"
}

capture_in_instance_logs '(\S+err\b)'
capture_in_instance_logs '(\S+out\b)'

echo "Waiting for Ollama server to open port ${ollama_port}..."
echo "TIMING - Starting wait at: $(date)"
if my_wait_until_port_used "127.0.0.1:${ollama_port}" 60; then
  echo "Discovered Ollama server listening on port ${ollama_port}!"
  echo "TIMING - Wait ended at: $(date)"
else
  echo "Timed out waiting for Jupyter Notebook server to open port ${ollama_port}!"
  echo "TIMING - Wait ended at: $(date)"
fi

# =======================================
# Startup Jupyter
# =======================================

cd "${HOME}"

<%- if context.python_env == "apptainer" %>
apptainer exec \
  --nv \
  --env "PYTHONNOUSERSITE=1" \
  --env "OLLAMA_HOST=$OLLAMA_HOST" \
  "<%= context.sif_path %>" jupyter "<%= context.jupyter_interface %>" --debug --config="$CONFIG_FILE" 
<%- else %>
jupyter "<%= context.jupyter_interface %>" --debug --config="$CONFIG_FILE" 
<%- end -%>
