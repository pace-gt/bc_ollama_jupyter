# Job submission configuration file
# Configure the content of the job script for the batch job here
# @see http://www.rubydoc.info/gems/ood_core/OodCore/BatchConnect/Template
#

batch_connect:
  template: basic

  # You can override the command used to query the hostname of the compute node
  # here
  #
  # @note It is **highly** recommended this be set in the global cluster
  #   configuration file so that all apps can take advantage of it by default
  #
  #set_host: "host=$(hostname -A | awk '{print $2}')"

#
# Configure the job script submission parameters for the batch job here
# @see http://www.rubydoc.info/gems/ood_core/OodCore/Job/Script
#
script:
  qos: <%= qos %>
  native: 
    - "--nodes=1"
    - "--ntasks-per-node=1"
    - "--cpus-per-task=<%= num_cores.blank? ? 1 : num_cores.to_i %>"
    <%- unless num_mem.blank? -%>
    - "--mem=<%= num_mem.to_i %>G"
    <%- end -%>
    <%- if node_type == "intel_cpu" -%> 
    - "--constraint=rhel9,intel"
    <%- elsif node_type == "amd_cpu" -%>
    - "--constraint=rhel9,amd"
    <%- else -%>
    <%- if num_gpus.to_i >0 -%>
    <%- if node_type == "V100_16GB" -%>
    - "--gres=gpu:V100:<%= num_gpus.to_i %>"
    - "--constraint=rhel9,V100-16GB"
    <%- elsif node_type == "V100_32GB" -%>
    - "--gres=gpu:V100:<%= num_gpus.to_i %>" 
    - "--constraint=rhel9,V100-32GB"
    <%- elsif node_type == "A100_40GB" -%>
    - "--gres=gpu:A100:<%= num_gpus.to_i %>" 
    - "--constraint=rhel9,A100-40GB"
    <%- elsif node_type == "A100_80GB" -%>
    - "--gres=gpu:A100:<%= num_gpus.to_i %>" 
    - "--constraint=rhel9,A100-80GB"
    <%- elsif node_type == "L40S" -%>
    - "--gres=gpu:L40S:<%= num_gpus.to_i %>"
    - "--constraint=rhel9"
    <%- elsif node_type == "RTX_6000" -%>
    - "--gres=gpu:RTX_6000:<%= num_gpus.to_i %>"
    - "--constraint=rhel9"
    <%- elsif node_type == "H100_HGX" -%>
    - "--gres=gpu:H100:<%= num_gpus.to_i %>"
    - "--constraint=rhel9,H100-HGX"
    <%- elsif node_type == "H100_DGX" -%>
    - "--gres=gpu:H100:<%= num_gpus.to_i %>"
    - "--constraint=rhel9,H100-DGX"
    <%- end -%>
    <%- end -%>
    <%- end -%>